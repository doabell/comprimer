<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Comprimer</AssemblyName>
    <RootNamespace>Comprimer</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Windows context menu tool for image compression and conversion</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comprimer.Core\Comprimer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
